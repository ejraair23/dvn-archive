# Salin file ini menjadi .env.local untuk development,
# atau isi Environment Variables ini di dashboard Vercel saat deploy.

# Kode untuk membuka halaman Secret File.
# Ganti dengan kode rahasia versi kamu. Jangan commit .env.local ke git.
NEXT_PUBLIC_SECRET_CODE=ubahaja123

# Kode preview untuk kamu sendiri (pembuat website), supaya bisa buka
# website sebelum tanggal unlock tanpa perlu menunggu seperti Divana.
# Ganti dengan kode versi kamu. Jangan commit .env.local ke git,
# dan jangan share kode ini ke Divana.
NEXT_PUBLIC_PREVIEW_CODE=previewaja123
